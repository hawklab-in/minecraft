# ==========================================
# Minecraft & Manager Environment Variables
# ==========================================

# -----------------
# Minecraft Server
# -----------------
# Minecraft version (default: LATEST or pinned version like 26.3)
MC_VERSION=LATEST

# Container memory allocation (e.g., 8G, 12G, 16G)
MEMORY=8G

# Container timezone
TZ=Asia/Kolkata

# Whether to enable Aikar's optimized JVM flags (recommended for Java servers)
USE_AIKAR_FLAGS=true

# Server-side mods to auto-download from Modrinth
# Note: c2me-fabric is excluded from the default release-channel list because it only publishes alpha channel builds.
MODRINTH_PROJECTS=fabric-api, lithium, ferrite-core, spark, bluemap, no-chat-reports

# Modrinth download options
MODRINTH_DOWNLOAD_DEPENDENCIES=required
MODRINTH_ALLOWED_VERSION_TYPE=release

# Account validation: FALSE allows offline/TLauncher clients
ONLINE_MODE=FALSE

# Whitelist enforcement (crucial when online mode is disabled)
ENABLE_WHITELIST=TRUE
ENFORCE_WHITELIST=TRUE

# RCON settings (internal communication between manager and minecraft)
RCON_PASSWORD=change_this_to_a_secure_random_rcon_password

# -----------------
# Admin Panel
# -----------------
# HTTP Basic Auth credentials for https://panel.hawklab.in
PANEL_USER=admin
PANEL_PASSWORD=change_this_to_a_secure_random_panel_password

# Panel domain for Coolify FQDN routing
PANEL_DOMAIN=panel.hawklab.in

# -----------------
# Discord Bot
# -----------------
# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Server (Guild) ID where the bot operates
DISCORD_GUILD_ID=your_discord_server_guild_id

# Role ID for the required "Minecraft" Discord role
DISCORD_ROLE_ID=your_minecraft_role_id
